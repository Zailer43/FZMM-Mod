<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21.6/owo-ui.xsd">
    <components>
        <fzmm.flow-layout direction="vertical">
            <children>
                <fzmm.label id="title">
                    <positioning type="absolute">3,3</positioning>
                    <text translate="true">fzmm.gui.title.main</text>
                </fzmm.label>

                <fzmm.flow-layout direction="vertical">
                    <children>
                        <fzmm.label id="hovered">
                            <margins>
                                <top>4  </top>
                            </margins>

                            <sizing>
                                <vertical method="fixed">12</vertical>
                            </sizing>
                        </fzmm.label>

                        <fzmm.flow-layout direction="ltr-text-flow" id="content">
                            <children>
                            </children>

                            <margins>
                                <top>4</top>
                                <bottom>4</bottom>
                            </margins>

                            <sizing>
                                <horizontal method="fixed">300</horizontal>
                            </sizing>

                            <gap>3</gap>
                        </fzmm.flow-layout>
                    </children>

                    <padding>
                        <all>6</all>
                    </padding>

                    <margins>
                        <bottom>20</bottom>
                    </margins>

                    <surface>
                        <panel dark="true"/>
                    </surface>

                    <horizontal-alignment>center</horizontal-alignment>
                </fzmm.flow-layout>

                <fzmm.flow-layout direction="horizontal">
                    <children>

                        <button id="config-button">
                            <text translate="true">fzmm.gui.title.configs.icon</text>
                            <tooltip-text translate="true">fzmm.gui.title.configs</tooltip-text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                                <horizontal method="fixed">16</horizontal>
                            </sizing>
                        </button>

                    </children>

                    <margins>
                        <top>3</top>
                        <right>3</right>
                    </margins>

                    <gap>8</gap>

                    <positioning type="relative">100,0</positioning>

                    <vertical-alignment>bottom</vertical-alignment>
                    <horizontal-alignment>right</horizontal-alignment>
                </fzmm.flow-layout>

                <fzmm.flow-layout direction="vertical">
                    <children>

                        <button id="back-button">
                            <text translate="true">fzmm.gui.button.back.icon</text>
                            <tooltip-text translate="true">fzmm.gui.button.back</tooltip-text>

                            <margins>
                                <right>3</right>
                                <bottom>3</bottom>
                            </margins>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </button>

                    </children>

                    <positioning type="relative">100,100</positioning>

                    <vertical-alignment>bottom</vertical-alignment>
                    <horizontal-alignment>right</horizontal-alignment>
                </fzmm.flow-layout>

            </children>

            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </fzmm.flow-layout>
    </components>

    <templates>
        <main-button-layout>
            <stack-layout>
                <children>
                    <fzmm.button id="{{name}}">
                        <margins>
                            <bottom>3</bottom>
                        </margins>

                        <sizing>
                            <horizontal method="fixed">40</horizontal>
                            <vertical method="fixed">40</vertical>
                        </sizing>
                    </fzmm.button>

                    <fzmm.texture texture="fzmm:textures/gui/widgets.png"
                             region-width="16" region-height="16"
                             u="{{u}}" v="{{v}}" id="icon">

                        <sizing>
                            <horizontal method="fixed">32</horizontal>
                            <vertical method="fixed">32</vertical>
                        </sizing>

                        <margins>
                            <all>4</all>
                        </margins>
                    </fzmm.texture>
                </children>
            </stack-layout>
        </main-button-layout>
    </templates>
</owo-ui>