<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21.5/owo-ui.xsd">
    <components>
        <fzmm.flow-layout direction="horizontal">
            <children>
                <fzmm.flow-layout direction="vertical">
                    <children>
                        <fzmm.label id="title">
                            <positioning type="absolute">3,3</positioning>
                            <text translate="true">fzmm.gui.title.bannerEditor</text>
                        </fzmm.label>

                        <fzmm.flow-layout direction="horizontal">
                            <children>
                                <fzmm.flow-layout direction="vertical">
                                    <children>
                                        <fzmm.boolean-button id="is-shield">
                                            <enabled-text translate="true">fzmm.gui.bannerEditor.option.isShield.enabled</enabled-text>
                                            <disabled-text translate="true">fzmm.gui.bannerEditor.option.isShield.disabled</disabled-text>

                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                                <vertical method="fixed">16</vertical>
                                            </sizing>
                                        </fzmm.boolean-button>

                                        <item id="banner-preview">
                                            <sizing>
                                                <horizontal method="fixed">100</horizontal>
                                                <vertical method="fixed">100</vertical>
                                            </sizing>
                                        </item>

                                        <button id="give-button">-->
                                            <text translate="true">fzmm.gui.bannerEditor.button.give</text>

                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                                <vertical method="fixed">16</vertical>
                                            </sizing>
                                        </button>

                                        <button id="select-banner-button">-->
                                            <text translate="true">fzmm.gui.bannerEditor.button.select</text>

                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                                <vertical method="fixed">16</vertical>
                                            </sizing>
                                        </button>

                                        <fzmm.flow-layout direction="horizontal">
                                            <children>
                                                <fzmm.button id="undo-button">
                                                    <text translate="true">fzmm.gui.button.arrow2.left</text>
                                                    <tooltip-text translate="true">fzmm.gui.editor.banner.option.undo.tooltip</tooltip-text>

                                                    <sizing>
                                                        <horizontal method="fixed">16</horizontal>
                                                        <vertical method="fixed">16</vertical>
                                                    </sizing>
                                                </fzmm.button>

                                                <spacer>
                                                    <sizing>
                                                        <vertical method="fixed">1</vertical>
                                                    </sizing>
                                                </spacer>

                                                <fzmm.button id="redo-button">
                                                    <text translate="true">fzmm.gui.button.arrow2.right</text>
                                                    <tooltip-text translate="true">fzmm.gui.editor.banner.option.redo.tooltip</tooltip-text>

                                                    <sizing>
                                                        <horizontal method="fixed">16</horizontal>
                                                        <vertical method="fixed">16</vertical>
                                                    </sizing>
                                                </fzmm.button>
                                            </children>

                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                                <vertical method="fixed">16 </vertical>
                                            </sizing>
                                        </fzmm.flow-layout>

                                        <fzmm.button id="clear-button">
                                            <text translate="true">fzmm.gui.button.clear</text>

                                            <positioning type="relative">0,100</positioning>

                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                                <vertical method="fixed">16</vertical>
                                            </sizing>
                                        </fzmm.button>
                                    </children>

                                    <sizing>
                                        <horizontal method="fixed">100</horizontal>
                                        <vertical method="expand">100</vertical>
                                    </sizing>

                                    <gap>2</gap>

                                    <vertical-alignment>top</vertical-alignment>
                                    <horizontal-alignment>center</horizontal-alignment>
                                </fzmm.flow-layout>

                                <fzmm.flow-layout direction="vertical">
                                    <children>
                                        <fzmm.flow-layout direction="vertical">
                                            <children>
                                                <fzmm.flow-layout direction="ltr-text-flow" id="color-layout">
                                                    <children>

                                                    </children>

                                                    <sizing>
                                                        <horizontal method="fill">100</horizontal>
                                                    </sizing>

                                                    <vertical-alignment>top</vertical-alignment>
                                                    <horizontal-alignment>center</horizontal-alignment>
                                                </fzmm.flow-layout>

                                                <fzmm.flow-layout direction="horizontal">
                                                    <children>
                                                        <fzmm.button id="add-pattern">
                                                            <text translate="true">fzmm.gui.bannerEditor.tab.addPatterns</text>
                                                            <tooltip-text translate="true">fzmm.gui.bannerEditor.tab.addPatterns.tooltip</tooltip-text>

                                                            <sizing>
                                                                <horizontal method="fill">33</horizontal>
                                                                <vertical method="fixed">16</vertical>
                                                            </sizing>
                                                        </fzmm.button>

                                                        <fzmm.button id="change-color">
                                                            <text translate="true">fzmm.gui.bannerEditor.tab.changeColor</text>
                                                            <tooltip-text translate="true">fzmm.gui.bannerEditor.tab.changeColor.tooltip</tooltip-text>

                                                            <sizing>
                                                                <horizontal method="expand">100</horizontal>
                                                                <vertical method="fixed">16</vertical>
                                                            </sizing>
                                                        </fzmm.button>

                                                        <fzmm.button id="remove-pattern">
                                                            <text translate="true">fzmm.gui.bannerEditor.tab.removePatterns</text>
                                                            <tooltip-text translate="true">fzmm.gui.bannerEditor.tab.removePatterns.tooltip</tooltip-text>

                                                            <sizing>
                                                                <horizontal method="fill">33</horizontal>
                                                                <vertical method="fixed">16</vertical>
                                                            </sizing>
                                                        </fzmm.button>
                                                    </children>

                                                    <sizing>
                                                        <horizontal method="expand">100</horizontal>
                                                    </sizing>

                                                    <margins>
                                                        <vertical>2</vertical>
                                                    </margins>

                                                    <horizontal-alignment>center</horizontal-alignment>

                                                    <gap>2</gap>
                                                </fzmm.flow-layout>
                                            </children>
                                        </fzmm.flow-layout>

                                        <fzmm.scroll direction="vertical">
                                            <fzmm.flow-layout direction="ltr-text-flow" id="content">
                                                <children>

                                                </children>

                                                <sizing>
                                                    <horizontal method="fill">100</horizontal>
                                                </sizing>

                                                <vertical-alignment>top</vertical-alignment>
                                                <horizontal-alignment>center</horizontal-alignment>
                                            </fzmm.flow-layout>

                                            <sizing>
                                                <vertical method="expand">100</vertical>
                                            </sizing>
                                        </fzmm.scroll>
                                    </children>

                                    <sizing>
                                        <horizontal method="fixed">300</horizontal>
                                        <vertical method="expand">100</vertical>
                                    </sizing>

                                    <surface>
                                        <panel dark="true"/>
                                    </surface>

                                    <padding>
                                        <all>6</all>
                                    </padding>
                                </fzmm.flow-layout>

                            </children>

                            <margins>
                                <top>20</top>
                            </margins>

                            <sizing>
                                <vertical method="expand">90</vertical>
                                <horizontal method="expand">100</horizontal>
                            </sizing>

                            <gap>4</gap>
                            <horizontal-alignment>center</horizontal-alignment>
                        </fzmm.flow-layout>
                    </children>
                </fzmm.flow-layout>

                <button id="back-button">
                    <text translate="true">fzmm.gui.button.back.icon</text>
                    <tooltip-text translate="true">fzmm.gui.button.back</tooltip-text>

                    <margins>
                        <right>3</right>
                        <bottom>3</bottom>
                    </margins>

                    <sizing>
                        <vertical method="fixed">16</vertical>
                    </sizing>

                    <positioning type="relative">100,100</positioning>
                </button>
            </children>

            <vertical-alignment>top</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </fzmm.flow-layout>
    </components>
</owo-ui>