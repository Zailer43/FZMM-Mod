<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21.5/owo-ui.xsd">
    <components>
        <fzmm.flow-layout direction="vertical">
            <children>
                <fzmm.label id="title">
                    <positioning type="absolute">3,3</positioning>
                    <text translate="true">fzmm.gui.title.converters</text>
                </fzmm.label>

                <fzmm.scroll direction="vertical">

                    <fzmm.flow-layout direction="vertical" id="options-list">
                        <children>
                            <fzmm.flow-layout direction="horizontal">
                                <children>
                                    <fzmm.button id="base64-button"/>
                                    <fzmm.button id="uuidToArray-button"/>
                                    <fzmm.button id="arrayToUuid-button"/>
                                </children>

                                <gap>2</gap>
                                <surface>
                                    <panel dark="true"/>
                                </surface>
                                <padding>
                                    <all>6</all>
                                </padding>
                                <margins>
                                    <vertical>2</vertical>
                                </margins>
                            </fzmm.flow-layout>

                            <fzmm.tab-container direction="vertical" id="tabs">
                                <children>
                                    <fzmm.label id="tab-label">
                                        <margins>
                                            <vertical>4</vertical>
                                        </margins>
                                    </fzmm.label>
                                </children>

                                <tabs>
                                    <fzmm.flow-layout direction="vertical" id="base64">
                                        <children>
                                            <fzmm.text-box-row>
                                                <id>message</id>
                                            </fzmm.text-box-row>
                                            <fzmm.button-row>
                                                <id>copyDecoded</id>
                                            </fzmm.button-row>
                                            <fzmm.button-row>
                                                <id>copyEncoded</id>
                                            </fzmm.button-row>
                                        </children>
                                    </fzmm.flow-layout>

                                    <fzmm.flow-layout direction="vertical" id="uuidToArray">
                                        <children>
                                            <fzmm.predicate-text-box-row>
                                                <id>uuidField</id>
                                            </fzmm.predicate-text-box-row>
                                            <fzmm.button-row>
                                                <id>uuidToArray.random</id>
                                            </fzmm.button-row>
                                            <fzmm.button-row>
                                                <id>uuidToArray.copy</id>
                                            </fzmm.button-row>
                                        </children>
                                    </fzmm.flow-layout>

                                    <fzmm.flow-layout direction="vertical" id="arrayToUuid">
                                        <children>
                                            <fzmm.number-row>
                                                <id>array.0</id>
                                                <tooltipId>array</tooltipId>
                                            </fzmm.number-row>
                                            <fzmm.number-row>
                                                <id>array.1</id>
                                                <tooltipId>array</tooltipId>
                                            </fzmm.number-row>
                                            <fzmm.number-row>
                                                <id>array.2</id>
                                                <tooltipId>array</tooltipId>
                                            </fzmm.number-row>
                                            <fzmm.number-row>
                                                <id>array.3</id>
                                                <tooltipId>array</tooltipId>
                                            </fzmm.number-row>
                                            <fzmm.button-row>
                                                <id>arrayToUuid.random</id>
                                            </fzmm.button-row>
                                            <fzmm.button-row>
                                                <id>arrayToUuid.copy</id>
                                            </fzmm.button-row>
                                        </children>
                                    </fzmm.flow-layout>
                                </tabs>

                                <horizontal-alignment>center</horizontal-alignment>
                            </fzmm.tab-container>
                        </children>

                        <horizontal-alignment>center</horizontal-alignment>
                    </fzmm.flow-layout>

                    <sizing>
                        <vertical method="fill">90</vertical>
                    </sizing>

                    <margins>
                        <top>10</top>
                        <bottom>30</bottom>
                    </margins>
                </fzmm.scroll>

                <fzmm.flow-layout direction="horizontal">
                    <children>

                        <button id="back-button">
                            <text translate="true">fzmm.gui.button.back.icon</text>
                            <tooltip-text translate="true">fzmm.gui.button.back</tooltip-text>

                            <margins>
                                <right>3</right>
                                <bottom>3</bottom>
                            </margins>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </button>

                    </children>

                    <positioning type="relative">100,100</positioning>

                    <vertical-alignment>bottom</vertical-alignment>
                    <horizontal-alignment>right</horizontal-alignment>
                </fzmm.flow-layout>
            </children>


            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </fzmm.flow-layout>
    </components>
</owo-ui>