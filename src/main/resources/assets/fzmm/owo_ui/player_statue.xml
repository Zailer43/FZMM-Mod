<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21.5/owo-ui.xsd">
    <components>
        <fzmm.flow-layout direction="vertical">
            <children>
                <fzmm.label id="title">
                    <positioning type="absolute">3,3</positioning>
                    <text translate="true">fzmm.gui.title.playerStatue</text>
                </fzmm.label>

                <fzmm.scroll direction="vertical">

                    <fzmm.flow-layout direction="vertical" id="options-list">
                        <children>
                            <fzmm.context-menu-button-row>
                                <id>horizontal-direction</id>
                            </fzmm.context-menu-button-row>
                            <fzmm.number-row>
                                <id>posX</id>
                                <tooltipId>pos</tooltipId>
                            </fzmm.number-row>
                            <fzmm.number-row>
                                <id>posY</id>
                                <tooltipId>pos</tooltipId>
                            </fzmm.number-row>
                            <fzmm.number-row>
                                <id>posZ</id>
                                <tooltipId>pos</tooltipId>
                            </fzmm.number-row>
                            <fzmm.text-box-row>
                                <id>name</id>
                                <symbolChatButtons>true</symbolChatButtons>
                            </fzmm.text-box-row>

                            <fzmm.flow-layout direction="horizontal">
                                <children>
                                    <fzmm.button id="generate-button"/>
                                    <fzmm.button id="update-button"/>
                                </children>

                                <gap>2</gap>
                                <surface>
                                    <panel dark="true"/>
                                </surface>
                                <padding>
                                    <all>6</all>
                                </padding>
                                <margins>
                                    <vertical>2</vertical>
                                </margins>
                            </fzmm.flow-layout>

                            <fzmm.tab-container direction="vertical" id="tabs">
                                <children>
                                    <fzmm.label id="tab-label">
                                        <margins>
                                            <vertical>4</vertical>
                                        </margins>
                                    </fzmm.label>
                                </children>

                                <tabs>
                                    <fzmm.flow-layout direction="vertical" id="generate">
                                        <children>
                                            <fzmm.image-rows>
                                                <buttonId>skin</buttonId>
                                                <imageModeId>skin-source</imageModeId>
                                            </fzmm.image-rows>
                                        </children>
                                    </fzmm.flow-layout>

                                    <fzmm.flow-layout direction="vertical" id="update">
                                        <children>
                                        </children>
                                    </fzmm.flow-layout>
                                </tabs>

                                <horizontal-alignment>center</horizontal-alignment>
                            </fzmm.tab-container>
                        </children>
                        <horizontal-alignment>center</horizontal-alignment>
                    </fzmm.flow-layout>

                    <sizing>
                        <vertical method="fill">90</vertical>
                    </sizing>

                </fzmm.scroll>

                <fzmm.flow-layout direction="horizontal">
                    <children>
                        <button id="execute-button">
                            <text translate="true">gui.done</text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </button>

                        <spacer>
                            <sizing>
                                <horizontal method="expand">100</horizontal>
                                <vertical method="fixed">1</vertical>
                            </sizing>
                        </spacer>

                        <button id="back-button">
                            <text translate="true">fzmm.gui.button.back.icon</text>
                            <tooltip-text translate="true">fzmm.gui.button.back</tooltip-text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </button>
                    </children>

                    <positioning type="relative">0,100</positioning>

                    <padding>
                        <horizontal>3</horizontal>
                        <bottom>3</bottom>
                    </padding>
                </fzmm.flow-layout>

                <fzmm.flow-layout direction="horizontal">
                    <children>
                        <button id="difficult-to-remove-entity-button">
                            <text translate="true">fzmm.snack_bar.entityDifficultToRemove.title</text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </button>

                        <button id="faq-button">
                            <text translate="true">fzmm.gui.button.faq</text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </button>
                    </children>

                    <gap>4</gap>

                    <positioning type="relative">100,0</positioning>

                    <padding>
                        <right>3</right>
                        <top>3</top>
                    </padding>
                </fzmm.flow-layout>
            </children>


            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </fzmm.flow-layout>
    </components>
</owo-ui>