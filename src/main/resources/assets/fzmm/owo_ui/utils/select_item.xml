<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21.5/owo-ui.xsd">
    <components>
        <fzmm.flow-layout direction="vertical">
            <children>
                <label id="title">
                    <positioning type="absolute">3,3</positioning>
                    <text translate="true">fzmm.gui.title.selectItem</text>
                </label>

                <fzmm.flow-layout direction="horizontal">
                    <children>
                        <fzmm.scroll direction="vertical">

                            <fzmm.flow-layout direction="vertical" id="requested-items-list">
                                <children>

                                </children>

                                <sizing>
                                    <horizontal method="fill">40</horizontal>
                                </sizing>

                                <surface>
                                    <flat>#40000000</flat>
                                </surface>
                            </fzmm.flow-layout>

                            <sizing>
                                <vertical method="fill">70</vertical>
                            </sizing>
                        </fzmm.scroll>

                        <fzmm.flow-layout direction="vertical">
                            <children>
                                <fzmm.flow-layout direction="vertical" id="source-buttons">
                                    <children>
                                        <template name="source-buttons">
                                            <left-button>inventory</left-button>
                                            <right-button>default</right-button>
                                        </template>
                                        <template name="source-buttons">
                                            <left-button>history</left-button>
                                            <right-button>all</right-button>
                                        </template>
                                    </children>

                                    <gap>4</gap>
                                </fzmm.flow-layout>

                                <fzmm.scroll direction="vertical">
                                    <fzmm.flow-layout direction="ltr-text-flow" id="item-layout">
                                        <children>

                                        </children>

                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                        </sizing>

                                    </fzmm.flow-layout>

                                    <sizing>
                                        <vertical method="fill">55</vertical>
                                    </sizing>

                                    <margins>
                                        <vertical>8</vertical>
                                    </margins>

                                </fzmm.scroll>

                                <fzmm.text-box-row>
                                    <id>item-search</id>
                                    <removeResetButton>true</removeResetButton>
                                    <removeHorizontalMargins>true</removeHorizontalMargins>
                                </fzmm.text-box-row>
                            </children>

                            <sizing>
                                <horizontal method="fill">45</horizontal>
                                <vertical method="fill">75</vertical>
                            </sizing>

                            <margins>
                                <bottom>5</bottom>
                            </margins>

                        </fzmm.flow-layout>

                    </children>

                    <gap>8</gap>
                </fzmm.flow-layout>

                <fzmm.flow-layout direction="horizontal">
                    <children>

                        <fzmm.button id="execute-button">
                            <text translate="true">gui.done</text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </fzmm.button>

                        <spacer>
                            <sizing>
                                <horizontal method="expand">100</horizontal>
                                <vertical method="fixed">1</vertical>
                            </sizing>
                        </spacer>

                        <fzmm.button id="back-button">
                            <text translate="true">fzmm.gui.button.back.icon</text>
                            <tooltip-text translate="true">fzmm.gui.button.back</tooltip-text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </fzmm.button>

                    </children>

                    <padding>
                        <horizontal>3</horizontal>
                        <bottom>3</bottom>
                    </padding>

                    <positioning type="relative">0,100</positioning>
                </fzmm.flow-layout>
            </children>

            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </fzmm.flow-layout>
    </components>

    <templates>
        <source-buttons>
            <fzmm.flow-layout direction="horizontal">
                <children>
                    <fzmm.button id="{{left-button}}-button">
                        <text translate="true">fzmm.gui.selectItem.button.source.{{left-button}}</text>

                        <sizing>
                            <horizontal method="fill">49</horizontal>
                        </sizing>
                    </fzmm.button>
                    <fzmm.button id="{{right-button}}-button">
                        <text translate="true">fzmm.gui.selectItem.button.source.{{right-button}}</text>

                        <sizing>
                            <horizontal method="fill">49</horizontal>
                        </sizing>
                    </fzmm.button>
                </children>

                <gap>4</gap>
            </fzmm.flow-layout>
        </source-buttons>

        <requested-item>
            <fzmm.flow-layout direction="horizontal">
                <children>
                    <item id="{{id}}-requested-item-item">
                    </item>

                    <fzmm.label id="{{id}}-requested-item-label">
                    </fzmm.label>
                </children>

                <gap>8</gap>

                <margins>
                    <all>2</all>
                </margins>

                <vertical-alignment>center</vertical-alignment>
            </fzmm.flow-layout>
        </requested-item>
    </templates>
</owo-ui>