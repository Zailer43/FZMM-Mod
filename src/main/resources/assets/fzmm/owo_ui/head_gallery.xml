<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21.5/owo-ui.xsd">
    <components>
        <fzmm.flow-layout direction="horizontal">
            <children>
                <fzmm.label id="title">
                    <positioning type="absolute">3,3</positioning>
                    <text translate="true">fzmm.gui.title.headGallery</text>
                </fzmm.label>


                <!-- Left options -->
                <fzmm.flow-layout direction="horizontal">
                    <children>
                        <fzmm.flow-layout direction="vertical" id="options-list">
                            <children>

                                <fzmm.flow-layout direction="vertical">
                                    <children>
                                        <fzmm.label>
                                            <text translate="true">fzmm.gui.headGallery.option.tag-search</text>
                                            <tooltip-text translate="true">fzmm.gui.headGallery.option.tag-search.tooltip</tooltip-text>
                                        </fzmm.label>
                                        <text-box id="content-search">
                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </text-box>
                                    </children>

                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </fzmm.flow-layout>

                                <fzmm.flow-layout direction="horizontal">
                                    <children>
                                        <button id="tags-button">
                                            <sizing>
                                                <horizontal method="fill">60</horizontal>
                                                <vertical method="fixed">16</vertical>
                                            </sizing>
                                        </button>

                                        <button id="clear-tags">
                                            <text translate="true">fzmm.gui.button.clear</text>

                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                                <vertical method="fixed">16</vertical>
                                            </sizing>
                                        </button>
                                    </children>

                                    <gap>4</gap>

                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </fzmm.flow-layout>

                                <fzmm.flow-layout direction="horizontal">
                                    <children>
                                        <fzmm.number-slider id="item-scale">

                                            <sizing>
                                                <horizontal method="fill">60</horizontal>
                                            </sizing>
                                        </fzmm.number-slider>

                                        <checkbox id="style-checkbox">
                                            <text translate="true">fzmm.gui.headGallery.option.style</text>
                                            <tooltip-text translate="true">fzmm.gui.headGallery.option.style.tooltip</tooltip-text>

                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                                <vertical method="fixed">16</vertical>
                                            </sizing>
                                        </checkbox>
                                    </children>

                                    <gap>4</gap>

                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>

                                    <vertical-alignment>center</vertical-alignment>
                                </fzmm.flow-layout>

                                <fzmm.label>
                                    <text translate="true">fzmm.gui.headGallery.label.category</text>
                                    <tooltip-text translate="true">fzmm.gui.headGallery.label.category.tooltip</tooltip-text>
                                    <margins>
                                        <top>4</top>
                                    </margins>
                                </fzmm.label>

                                <fzmm.scroll direction="vertical">
                                    <fzmm.flow-layout direction="vertical" id="minecraft-heads-category-list">
                                        <children>

                                        </children>
                                        <sizing>
                                            <horizontal method="expand">100</horizontal>
                                        </sizing>
                                    </fzmm.flow-layout>

                                    <sizing>
                                        <vertical method="expand">100</vertical>
                                    </sizing>
                                </fzmm.scroll>

                            </children>

                            <gap>2</gap>

                            <sizing>
                                <horizontal method="fixed">180</horizontal>
                                <vertical method="fill">80</vertical>
                            </sizing>

                        </fzmm.flow-layout>

                    </children>

                    <padding>
                        <right>4</right>
                    </padding>

                    <margins>
                        <left>4</left>
                    </margins>
                </fzmm.flow-layout>

                <!-- Gallery -->
                <fzmm.flow-layout direction="vertical" id="gallery-layout">
                    <children>
                        <fzmm.flow-layout direction="horizontal">
                            <children>
                                <button id="previous-page-button">
                                    <positioning type="relative">0,100</positioning>
                                    <text translate="true">fzmm.gui.button.arrow2.left</text>

                                    <sizing>
                                        <vertical method="fixed">16</vertical>
                                    </sizing>
                                </button>
                                <fzmm.label id="current-page-label">
                                    <text>0/0</text>
                                </fzmm.label>
                                <button id="next-page-button">
                                    <positioning type="relative">100,100</positioning>
                                    <text translate="true">fzmm.gui.button.arrow2.right</text>

                                    <sizing>
                                        <vertical method="fixed">16</vertical>
                                    </sizing>
                                </button>
                            </children>

                            <vertical-alignment>center</vertical-alignment>
                            <horizontal-alignment>center</horizontal-alignment>

                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fixed">18</vertical>
                            </sizing>
                            <margins>
                                <all>1</all>
                            </margins>

                            <positioning type="relative">0,100</positioning>
                        </fzmm.flow-layout>

                        <fzmm.flow-layout direction="vertical">
                            <children>
                                <fzmm.label id="error-message">

                                    <margins>
                                        <all>4</all>
                                    </margins>

                                    <positioning type="relative">0,0</positioning>

                                    <sizing>
                                        <horizontal method="expand">100</horizontal>
                                    </sizing>
                                </fzmm.label>

                                <fzmm.scroll direction="vertical" id="content-scroll">
                                    <fzmm.flow-layout direction="ltr-text-flow" id="content">
                                        <children>

                                        </children>

                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                        </sizing>

                                        <vertical-alignment>top</vertical-alignment>
                                        <horizontal-alignment>left</horizontal-alignment>
                                    </fzmm.flow-layout>

                                    <sizing>
                                        <vertical method="fill">100</vertical>
                                    </sizing>

                                </fzmm.scroll>
                            </children>

                            <margins>
                                <bottom>20</bottom>
                            </margins>

                            <sizing>
                                <vertical method="fill">100</vertical>
                            </sizing>

                        </fzmm.flow-layout>
                    </children>

                    <sizing>
                        <horizontal method="expand">100</horizontal>
                        <vertical method="fill">80</vertical>
                    </sizing>

                    <surface>
                        <panel dark="true"/>
                    </surface>

                    <padding>
                        <all>6</all>
                    </padding>

                    <horizontal-alignment>center</horizontal-alignment>
                    <vertical-alignment>center</vertical-alignment>
                </fzmm.flow-layout>

                <!-- Right options -->
                <fzmm.flow-layout direction="vertical" id="preview-layout">
                    <children>
                    </children>

                    <sizing>
                        <horizontal method="fixed">48</horizontal>
                        <vertical method="fill">80</vertical>
                    </sizing>

                    <margins>
                        <right>4</right>
                    </margins>
                </fzmm.flow-layout>

                <fzmm.flow-layout direction="horizontal">
                    <children>
                        <fzmm.flow-layout direction="horizontal">
                            <children>

                                <button id="minecraft-heads-button">
                                    <text translate="true">fzmm.gui.headGallery.button.minecraftHeads</text>

                                    <sizing>
                                        <vertical method="fixed">16</vertical>
                                    </sizing>
                                </button>

                                <button id="back-button">
                                    <text translate="true">fzmm.gui.button.back.icon</text>
                                    <tooltip-text translate="true">fzmm.gui.button.back</tooltip-text>

                                    <sizing>
                                        <vertical method="fixed">16</vertical>
                                    </sizing>
                                </button>

                            </children>

                            <gap>8</gap>

                            <padding>
                                <right>3</right>
                                <bottom>3</bottom>
                            </padding>
                        </fzmm.flow-layout>

                    </children>

                    <positioning type="relative">100,100</positioning>

                    <vertical-alignment>bottom</vertical-alignment>
                    <horizontal-alignment>right</horizontal-alignment>
                </fzmm.flow-layout>
            </children>


            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </fzmm.flow-layout>
    </components>

    <templates>
        <option-button>
            <button id="{{id}}">
                <text translate="true">fzmm.gui.history.option.{{translation}}</text>

                <sizing>
                    <horizontal method="fill">97</horizontal>
                </sizing>

                <margins>
                    <vertical>4</vertical>
                </margins>
            </button>
        </option-button>

        <select-tag>
            <fzmm.flow-layout direction="vertical">
                <children>
                    <fzmm.label id="tags-overlay-label">
                        <margins>
                            <top>3</top>
                        </margins>
                    </fzmm.label>

                    <fzmm.flow-layout direction="horizontal">
                        <children>
                            <text-box id="tag-search">
                                <sizing>
                                    <horizontal method="fill">70</horizontal>
                                </sizing>
                            </text-box>

                            <button id="clear-tags-overlay">
                                <text translate="true">fzmm.gui.button.clear</text>

                                <sizing>
                                    <horizontal method="expand">100</horizontal>
                                </sizing>
                            </button>
                        </children>
                        <vertical-alignment>center</vertical-alignment>

                        <gap>2</gap>
                    </fzmm.flow-layout>

                    <fzmm.scroll direction="vertical" id="tag-scroll">
                        <fzmm.flow-layout direction="ltr-text-flow" id="minecraft-heads-tags-ltr">
                            <children>

                            </children>

                            <vertical-alignment>top</vertical-alignment>
                            <horizontal-alignment>center</horizontal-alignment>

                            <sizing>
                                <horizontal method="fill">100</horizontal>
                            </sizing>

                            <gap>4</gap>
                        </fzmm.flow-layout>

                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="expand">100</vertical>
                        </sizing>
                    </fzmm.scroll>
                </children>

                <horizontal-alignment>center</horizontal-alignment>
                <vertical-alignment>top</vertical-alignment>

                <sizing>
                    <horizontal method="fill">80</horizontal>
                    <vertical method="fill">80</vertical>
                </sizing>

                <gap>5</gap>
                <padding>
                    <all>5</all>
                </padding>
                <surface>
                    <panel dark="true"/>
                </surface>

                <z-index>300</z-index>
            </fzmm.flow-layout>
        </select-tag>
    </templates>
</owo-ui>