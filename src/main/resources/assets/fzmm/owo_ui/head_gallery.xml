<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21.6/owo-ui.xsd">
    <components>
        <fzmm.flow-layout direction="horizontal">
            <children>
                <fzmm.label id="title">
                    <positioning type="absolute">3,3</positioning>
                    <text translate="true">fzmm.gui.title.headGallery</text>
                </fzmm.label>

                <!-- Left options -->
                <fzmm.flow-layout direction="horizontal"> <!-- Wrapper to fix owo-lib #348 -->
                    <children>
                        <fzmm.flow-layout direction="vertical" id="options-list">
                            <children>

                                <fzmm.flow-layout direction="vertical">
                                    <children>
                                        <!-- Searcher -->
                                        <fzmm.flow-layout direction="vertical">
                                            <children>
                                                <fzmm.flow-layout direction="horizontal">
                                                    <children>
                                                        <fzmm.label>
                                                            <text translate="true">fzmm.gui.search.label</text>

                                                            <sizing>
                                                                <horizontal method="expand">100</horizontal>
                                                            </sizing>
                                                        </fzmm.label>

                                                        <fzmm.button id="advanced-search">
                                                            <text translate="true">fzmm.gui.search.advanced.label</text>

                                                            <sizing>
                                                                <vertical method="fixed">16</vertical>
                                                            </sizing>
                                                        </fzmm.button>
                                                    </children>

                                                    <vertical-alignment>top</vertical-alignment>
                                                </fzmm.flow-layout>

                                                <text-box id="content-search">
                                                    <sizing>
                                                        <horizontal method="expand">100</horizontal>
                                                    </sizing>
                                                </text-box>

                                            </children>
                                            <gap>2</gap>

                                            <sizing>
                                                <horizontal method="expand">100</horizontal>
                                            </sizing>
                                        </fzmm.flow-layout>

                                        <!-- Tags -->
                                        <fzmm.flow-layout direction="horizontal">
                                            <children>
                                                <fzmm.button id="tags-button">
                                                    <text translate="true">fzmm.gui.headGallery.button.tags</text>

                                                    <sizing>
                                                        <horizontal method="fill">60</horizontal>
                                                        <vertical method="fixed">16</vertical>
                                                    </sizing>
                                                </fzmm.button>

                                                <fzmm.button id="clear-tags">
                                                    <text translate="true">fzmm.gui.button.clear</text>

                                                    <sizing>
                                                        <horizontal method="expand">100</horizontal>
                                                        <vertical method="fixed">16</vertical>
                                                    </sizing>
                                                </fzmm.button>
                                            </children>

                                            <gap>4</gap>

                                            <sizing>
                                                <horizontal method="fill">100</horizontal>
                                            </sizing>
                                        </fzmm.flow-layout>

                                        <!-- Scale and style -->
                                        <fzmm.flow-layout direction="horizontal">
                                            <children>
                                                <fzmm.number-slider id="item-scale">

                                                    <sizing>
                                                        <horizontal method="fill">60</horizontal>
                                                        <vertical method="fixed">16</vertical>
                                                    </sizing>
                                                </fzmm.number-slider>

                                                <fzmm.button id="display-button">
                                                    <text translate="true">fzmm.gui.headGallery.option.display</text>
                                                    <tooltip-text translate="true">fzmm.gui.headGallery.option.display.tooltip</tooltip-text>

                                                    <sizing>
                                                        <horizontal method="expand">100</horizontal>
                                                        <vertical method="fixed">16</vertical>
                                                    </sizing>
                                                </fzmm.button>
                                            </children>

                                            <gap>4</gap>

                                            <sizing>
                                                <horizontal method="fill">100</horizontal>
                                            </sizing>

                                            <vertical-alignment>center</vertical-alignment>
                                        </fzmm.flow-layout>
                                    </children>

                                    <gap>2</gap>
                                </fzmm.flow-layout>

                                <!-- Content filter (categories, self collections, other collections) -->
                                <fzmm.scroll direction="vertical">
                                    <fzmm.flow-layout direction="vertical">
                                        <children>
                                            <fzmm.context-menu-button id="filter-button">
                                                <text translate="true">fzmm.gui.headGallery.button.categories</text>
                                                <sizing>
                                                    <vertical method="fixed">16</vertical>
                                                    <horizontal method="expand">100</horizontal>
                                                </sizing>
                                            </fzmm.context-menu-button>

                                            <fzmm.flow-layout direction="vertical" id="filter-layout">
                                                <children>

                                                </children>

                                                <margins>
                                                    <top>4</top>
                                                </margins>

                                                <sizing>
                                                    <horizontal method="expand">100</horizontal>
                                                </sizing>
                                            </fzmm.flow-layout>
                                        </children>

                                        <surface>
                                            <panel dark="true"/>
                                        </surface>

                                        <padding>
                                            <all>4</all>
                                        </padding>
                                    </fzmm.flow-layout>

                                    <sizing>
                                        <vertical method="expand">100</vertical>
                                    </sizing>
                                </fzmm.scroll>

                            </children>

                            <gap>2</gap>

                            <sizing>
                                <horizontal method="fixed">180</horizontal>
                                <vertical method="fill">80</vertical>
                            </sizing>

                        </fzmm.flow-layout>

                    </children>

                    <padding>
                        <right>4</right>
                    </padding>

                    <margins>
                        <left>4</left>
                    </margins>
                </fzmm.flow-layout>

                <!-- Content of gallery -->
                <fzmm.flow-layout direction="vertical" id="gallery-layout">
                    <children>
                        <fzmm.flow-layout direction="horizontal">
                            <children>
                                <fzmm.button id="previous-page-button">
                                    <positioning type="relative">0,100</positioning>
                                    <text translate="true">fzmm.gui.button.arrow2.left</text>

                                    <sizing>
                                        <vertical method="fixed">16</vertical>
                                    </sizing>
                                </fzmm.button>
                                <fzmm.label id="current-page-label">
                                    <text>0/0</text>
                                </fzmm.label>
                                <fzmm.button id="next-page-button">
                                    <positioning type="relative">100,100</positioning>
                                    <text translate="true">fzmm.gui.button.arrow2.right</text>

                                    <sizing>
                                        <vertical method="fixed">16</vertical>
                                    </sizing>
                                </fzmm.button>
                            </children>

                            <vertical-alignment>center</vertical-alignment>
                            <horizontal-alignment>center</horizontal-alignment>

                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fixed">16</vertical>
                            </sizing>

                            <margins>
                                <all>1</all>
                            </margins>

                            <positioning type="relative">0,100</positioning>
                        </fzmm.flow-layout>

                        <fzmm.flow-layout direction="vertical">
                            <children>
                                <fzmm.scroll direction="vertical" id="content-scroll">
                                    <fzmm.flow-layout direction="ltr-text-flow" id="content">
                                        <children>

                                        </children>

                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                        </sizing>

                                        <vertical-alignment>top</vertical-alignment>
                                        <horizontal-alignment>left</horizontal-alignment>
                                    </fzmm.flow-layout>

                                    <sizing>
                                        <vertical method="fill">100</vertical>
                                    </sizing>

                                </fzmm.scroll>
                            </children>

                            <margins>
                                <bottom>20</bottom>
                            </margins>

                            <sizing>
                                <vertical method="fill">100</vertical>
                            </sizing>

                        </fzmm.flow-layout>
                    </children>

                    <sizing>
                        <horizontal method="expand">100</horizontal>
                        <vertical method="fill">80</vertical>
                    </sizing>

                    <surface>
                        <panel dark="true"/>
                    </surface>

                    <padding>
                        <all>6</all>
                    </padding>

                    <horizontal-alignment>center</horizontal-alignment>
                    <vertical-alignment>center</vertical-alignment>
                </fzmm.flow-layout>

                <!-- Preview at right -->
                <fzmm.flow-layout direction="vertical" id="preview-layout">
                    <children>
                    </children>

                    <sizing>
                        <horizontal method="fixed">48</horizontal>
                        <vertical method="fill">80</vertical>
                    </sizing>

                    <margins>
                        <right>4</right>
                    </margins>
                </fzmm.flow-layout>

                <!-- Footer (license at left) -->
                <fzmm.label id="license-label">
                    <text translate="true">fzmm.gui.headGallery.label.license</text>

                    <margins>
                        <left>3</left>
                        <bottom>3</bottom>
                    </margins>

                    <positioning type="relative">0,100</positioning>
                </fzmm.label>

                <!-- Footer (buttons at right) -->
                <fzmm.flow-layout direction="horizontal">
                    <children>
                        <fzmm.button id="minecraft-heads-button">
                            <text translate="true">fzmm.gui.headGallery.button.minecraftHeads</text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </fzmm.button>

                        <fzmm.button id="back-button">
                            <text translate="true">fzmm.gui.button.back.icon</text>
                            <tooltip-text translate="true">fzmm.gui.button.back</tooltip-text>

                            <sizing>
                                <vertical method="fixed">16</vertical>
                            </sizing>
                        </fzmm.button>
                    </children>

                    <gap>8</gap>

                    <padding>
                        <right>3</right>
                        <bottom>3</bottom>
                    </padding>

                    <positioning type="relative">100,100</positioning>

                    <vertical-alignment>bottom</vertical-alignment>
                    <horizontal-alignment>right</horizontal-alignment>
                </fzmm.flow-layout>
            </children>


            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>
        </fzmm.flow-layout>
    </components>

    <templates>
        <option-button>
            <fzmm.button id="{{id}}">
                <text translate="true">fzmm.gui.history.option.{{translation}}</text>

                <sizing>
                    <horizontal method="fill">97</horizontal>
                </sizing>

                <margins>
                    <vertical>4</vertical>
                </margins>
            </fzmm.button>
        </option-button>

        <select-tag>
            <fzmm.flow-layout direction="vertical">
                <children>
                    <fzmm.label id="tags-overlay-label">
                        <margins>
                            <top>3</top>
                        </margins>
                    </fzmm.label>

                    <fzmm.flow-layout direction="horizontal">
                        <!-- search|clear -->
                        <children>
                            <text-box id="tag-search">
                                <sizing>
                                    <horizontal method="fill">70</horizontal>
                                </sizing>
                            </text-box>

                            <fzmm.button id="clear-tags-overlay">
                                <text translate="true">fzmm.gui.button.clear</text>

                                <sizing>
                                    <horizontal method="expand">100</horizontal>
                                </sizing>
                            </fzmm.button>
                        </children>
                        <vertical-alignment>center</vertical-alignment>

                        <gap>2</gap>
                    </fzmm.flow-layout>

                    <fzmm.flow-layout direction="horizontal">
                        <!-- tags content -->
                        <children>
                            <fzmm.scroll direction="vertical">
                                <fzmm.flow-layout direction="ltr-text-flow" id="tags-content">
                                    <children>

                                    </children>

                                    <vertical-alignment>top</vertical-alignment>
                                    <horizontal-alignment>center</horizontal-alignment>

                                    <sizing>
                                        <horizontal method="expand">100</horizontal>
                                    </sizing>

                                    <gap>4</gap>
                                </fzmm.flow-layout>

                                <sizing>
                                    <horizontal method="expand">100</horizontal>
                                    <vertical method="expand">100</vertical>
                                </sizing>
                            </fzmm.scroll>
                        </children>

                        <gap>4</gap>

                        <sizing>
                            <horizontal method="expand">100</horizontal>
                            <vertical method="expand">100</vertical>
                        </sizing>
                    </fzmm.flow-layout>
                </children>

                <horizontal-alignment>center</horizontal-alignment>
                <vertical-alignment>top</vertical-alignment>

                <sizing>
                    <horizontal method="fill">80</horizontal>
                    <vertical method="fill">80</vertical>
                </sizing>

                <gap>5</gap>
                <padding>
                    <all>5</all>
                </padding>
                <surface>
                    <panel dark="true"/>
                </surface>

                <z-index>300</z-index>
            </fzmm.flow-layout>
        </select-tag>

        <!-- Init overlay if missing api key -->
        <ask-api-key-overlay>
            <fzmm.flow-layout direction="vertical">
                <children>
                    <fzmm.label>
                        <text translate="true">fzmm.gui.headGallery.overlay.askApiKey.label.description</text>

                        <sizing>
                            <horizontal method="expand">100</horizontal>
                        </sizing>
                    </fzmm.label>

                    <fzmm.flow-layout direction="horizontal">
                        <children>
                            <fzmm.button id="license-types-button">
                                <text translate="true">fzmm.gui.headGallery.overlay.askApiKey.button.licenseTypes</text>
                            </fzmm.button>

                            <fzmm.button id="api-key-button">
                                <text translate="true">fzmm.gui.headGallery.overlay.askApiKey.button.apiKey</text>
                            </fzmm.button>
                        </children>

                        <gap>4</gap>
                    </fzmm.flow-layout>

                    <fzmm.flow-layout direction="horizontal">
                        <children>
                            <fzmm.label>
                                <text translate="true">fzmm.gui.headGallery.overlay.askApiKey.option.apiKey</text>
                            </fzmm.label>

                            <text-box id="api-key">

                                <sizing>
                                    <horizontal method="fixed">200</horizontal>
                                </sizing>
                            </text-box>
                        </children>

                        <vertical-alignment>center</vertical-alignment>

                        <margins>
                            <vertical>12</vertical>
                        </margins>

                        <gap>4</gap>
                    </fzmm.flow-layout>

                    <fzmm.label id="tags-note">
                        <text translate="true">fzmm.gui.headGallery.overlay.askApiKey.label.tagsNote</text>

                        <sizing>
                            <horizontal method="expand">100</horizontal>
                        </sizing>
                    </fzmm.label>

                    <checkbox id="dont-ask-again-checkbox">
                        <text translate="true">fzmm.gui.headGallery.overlay.askApiKey.option.dontAskAgain</text>
                    </checkbox>

                    <fzmm.button id="done-button">
                        <text translate="true">gui.done</text>
                    </fzmm.button>
                </children>

                <horizontal-alignment>left</horizontal-alignment>

                <gap>8</gap>

                <sizing>
                    <horizontal method="fixed">400</horizontal>
                </sizing>

                <padding>
                    <all>6</all>
                </padding>

                <surface>
                    <panel dark="true"/>
                </surface>
            </fzmm.flow-layout>
        </ask-api-key-overlay>

        <!-- Init overlay if automatically fetch is disabled -->
        <ask-fetch-overlay>
            <fzmm.flow-layout direction="vertical">
                <children>
                    <checkbox id="automatically-fetch-checkbox">
                        <text translate="true">fzmm.gui.headGallery.overlay.fetch.automaticallyFetch</text>
                        <tooltip-text translate="true">fzmm.gui.headGallery.overlay.fetch.automaticallyFetch.tooltip</tooltip-text>
                    </checkbox>

                    <fzmm.flow-layout direction="horizontal">
                        <children>
                            <fzmm.button id="load-heads-button">
                                <text translate="true">fzmm.gui.headGallery.overlay.fetch.button</text>
                            </fzmm.button>

                            <spacer>
                                <sizing>
                                    <vertical method="fixed">1</vertical>
                                    <horizontal method="expand">100</horizontal>
                                </sizing>
                            </spacer>

                            <fzmm.button id="cancel-button">
                                <text translate="true">fzmm.gui.button.cancel</text>
                            </fzmm.button>
                        </children>
                    </fzmm.flow-layout>

                </children>

                <horizontal-alignment>left</horizontal-alignment>

                <gap>4</gap>

                <sizing>
                    <horizontal method="fixed">400</horizontal>
                </sizing>

                <padding>
                    <all>6</all>
                </padding>

                <surface>
                    <panel dark="true"/>
                </surface>
            </fzmm.flow-layout>
        </ask-fetch-overlay>
    </templates>
</owo-ui>